<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="MudBlazor" Version="8.15.0" />
    <PackageReference Include="Markdig.Signed" Version="0.44.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The user guide is shown in the app as help: one source for the document and the app. -->
    <EmbeddedResource Include="..\..\docs\USER_GUIDE.md" LogicalName="USER_GUIDE.md" Link="Help\USER_GUIDE.md" />
    <!-- Translations of the guide: same headings in the same order (see Services/UserGuide.cs). -->
    <EmbeddedResource Include="..\..\docs\USER_GUIDE.*.md" LogicalName="%(Filename)%(Extension)" Link="Help\%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SPOReplaceLink.Engine\SPOReplaceLink.Engine.csproj" />
  </ItemGroup>

</Project>
