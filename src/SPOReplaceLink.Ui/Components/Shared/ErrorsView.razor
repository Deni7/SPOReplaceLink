@* GUI-7: failed, deferred and attention files grouped by status and message, with actions on a whole group. *@
@inject RunService Runs
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<div class="d-flex align-center flex-wrap gap-2 mb-2">
    <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
        @foreach (var (scope, text) in Scopes)
        {
            <MudButton Variant="@(scope == Scope ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="() => ScopeChanged.InvokeAsync(scope)">@text</MudButton>
        }
    </MudButtonGroup>
    <MudSpacer />
    <HelpButton Section="39-класи-помилок-і-що-робити" Text="@L.T("Класи помилок і що робити")" />
</div>

@if (_groups.Count == 0)
{
    <MudAlert Severity="Severity.Success">@Empty</MudAlert>
    return;
}

<MudTable Items="_groups" Dense="true" Hover="true" T="StateStore.ErrorGroup">
    <HeaderContent>
        <MudTh>@L.T("Файлів")</MudTh><MudTh>@L.T("Статус")</MudTh><MudTh>@L.T("Клас")</MudTh><MudTh>@L.T("Повідомлення")</MudTh><MudTh>@L.T("Що робити")</MudTh><MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><b>@Ui.N(context.Count)</b></MudTd>
        <MudTd><MudChip T="string" Size="Size.Small" Color="Ui.FileColor(context.Status)">@context.Status</MudChip></MudTd>
        <MudTd>@Ui.ErrorClass(context.ErrorClass)</MudTd>
        <MudTd><MudText Typo="Typo.body2" Class="wrap-anywhere">@(context.Error ?? "—")</MudText></MudTd>
        <MudTd><MudText Typo="Typo.caption">@Recommend(context)</MudText></MudTd>
        <MudTd Class="nowrap">
            <MudTooltip Text="@L.T("Показати файли групи")">
                <MudIconButton Icon="@Icons.Material.Filled.List" Size="Size.Small" OnClick="() => Toggle(context)" />
            </MudTooltip>
            <MudTooltip Text="@L.T("Повторити групу")">
                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" Disabled="!CanRetry" OnClick="() => Retry(context)" />
            </MudTooltip>
            <MudTooltip Text="@L.T("Ігнорувати групу")">
                <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" OnClick="() => Ignore(context)" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (_open == context)
        {
            <MudTr>
                <td colspan="6">
                    <MudList T="string" Dense="true">
                        @foreach (var f in _openFiles)
                        {
                            <MudListItem T="string" OnClick="@(() => Nav.NavigateTo($"files/{f.Id}"))">
                                <MudText Typo="Typo.body2" Class="wrap-anywhere">@f.Path · @L.F("спроб {0}", f.Attempts)</MudText>
                            </MudListItem>
                        }
                    </MudList>
                    @if (context.Count > _openFiles.Count)
                    {
                        <MudText Typo="Typo.caption" Class="px-4">@L.F("Показано {0} з {1}; усі — на вкладці «Файли» з фільтром за статусом.", _openFiles.Count, Ui.N(context.Count))</MudText>
                    }
                </td>
            </MudTr>
        }
    </ChildRowContent>
</MudTable>

@code {
    [Parameter, EditorRequired] public long RunId { get; set; }

    /// <summary>Only failed files (the "Помилки" card), only files that need attention (that card), or both with deferred ones.</summary>
    [Parameter] public StateStore.ErrorScope Scope { get; set; }
    [Parameter] public EventCallback<StateStore.ErrorScope> ScopeChanged { get; set; }

    private static (StateStore.ErrorScope, string)[] Scopes =>
        [(StateStore.ErrorScope.All, L.T("Усе")), (StateStore.ErrorScope.Failed, L.T("Помилки")), (StateStore.ErrorScope.Attention, L.T("Потребують уваги"))];

    private string Empty => Scope switch
    {
        StateStore.ErrorScope.Failed => L.T("Помилок немає."),
        StateStore.ErrorScope.Attention => L.T("Файлів, що потребують уваги, немає."),
        _ => L.T("Помилок і файлів, що потребують уваги, немає."),
    };

    private IReadOnlyList<StateStore.ErrorGroup> _groups = [];
    private StateStore.ErrorGroup? _open;
    private List<FileRow> _openFiles = [];
    private RunRow? _run;

    private bool CanRetry => _run is not null && Runs.Active?.RunId != RunId;

    protected override void OnParametersSet() => Load();

    private void Load()
    {
        _run = Runs.Store.GetRun(RunId);
        _groups = Runs.Store.GroupErrors(RunId, Scope);
        if (_open is not null && !_groups.Contains(_open))
            _open = null;
    }

    private string Recommend(StateStore.ErrorGroup g) =>
        ReportExporter.Recommend(new FileRow { Status = g.Status, StatusCode = g.Status, ErrorClass = g.ErrorClass });

    private void Toggle(StateStore.ErrorGroup g)
    {
        if (_open == g)
        {
            _open = null;
            return;
        }
        _open = g;
        var ids = Runs.Store.FileIdsOfGroup(RunId, g.Status, g.Error).Take(50).ToList();
        _openFiles = Runs.Store.QueryFiles(RunId, new FileFilter { FileIds = ids }, 0, 50).ToList();
    }

    private async Task Retry(StateStore.ErrorGroup g)
    {
        var ids = Runs.Store.FileIdsOfGroup(RunId, g.Status, g.Error);
        var status = new RunStatus(RunInfo.From(_run!), new Dictionary<string, long>(), 0, 0, 0, 0, 0, false, false, null);
        var parameters = new DialogParameters<RetryDialog> { { x => x.Parent, status }, { x => x.FileIds, ids } };
        var dialog = await Dialogs.ShowAsync<RetryDialog>(L.T("Повторити групу"), parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: long id })
            Nav.NavigateTo($"runs/{id}");
    }

    private async Task Ignore(StateStore.ErrorGroup g)
    {
        var dialog = await Dialogs.ShowAsync<CommentDialog>(L.T("Ігнорувати групу"), new DialogParameters<CommentDialog>
        {
            { x => x.Text, L.F("Файлів: {0}. Вони не братимуться в наступні повтори.", g.Count) },
        });
        if (await dialog.Result is { Canceled: false, Data: string comment })
        {
            int n = Runs.Store.IgnoreMany(Runs.Store.FileIdsOfGroup(RunId, g.Status, g.Error), comment, DateTimeOffset.UtcNow);
            Snackbar.Add(L.F("Позначено ignored: {0}", n), Severity.Info);
            Load();
        }
    }
}
