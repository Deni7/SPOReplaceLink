@* GUI-27: validation messages; rule issues carry the rule number. *@
@if (Issues.Count == 0)
{
    @if (ShowOk)
    {
        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">@L.T("Помилок немає.")</MudAlert>
    }
}
else
{
    <MudStack Spacing="1" Class="mt-2">
        @foreach (var i in Issues.OrderByDescending(i => i.Severity))
        {
            <MudAlert Severity="@(i.Severity == IssueSeverity.Error ? Severity.Error : Severity.Warning)" Dense="true">
                @(i.RuleIndex is int r ? L.F("Правило {0}: ", r) : "")@i.Message
            </MudAlert>
        }
    </MudStack>
}

@code {
    [Parameter] public IReadOnlyList<ValidationIssue> Issues { get; set; } = [];
    [Parameter] public bool ShowOk { get; set; } = true;
}
