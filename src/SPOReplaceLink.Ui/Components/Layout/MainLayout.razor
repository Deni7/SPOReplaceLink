@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawer = !_drawer" aria-label="@L.T("Меню")" />
        <img src="_content/SPOReplaceLink.Ui/logo.svg" alt="" width="28" height="28" class="ml-2" style="display:block" />
        <MudText Typo="Typo.h6" Class="ml-2">SPOReplaceLink</MudText>
        <MudSpacer />
        <MudText Typo="Typo.caption">@L.T("Заміна посилань в Excel після міграції в SharePoint Online")</MudText>
        <MudMenu Icon="@Icons.Material.Filled.Translate" Color="Color.Inherit" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                 aria-label="@L.T("Мова")" Class="ml-2">
            @foreach (var (code, name) in L.Languages)
            {
                <MudMenuItem OnClick="() => SetLanguage(code)" Icon="@(code == L.Language ? Icons.Material.Filled.Check : null)">@name</MudMenuItem>
            }
        </MudMenu>
        <MudTooltip Text="@L.T("Довідка")">
            <MudIconButton Icon="@Icons.Material.Outlined.HelpOutline" Color="Color.Inherit" Href="help" aria-label="@L.T("Довідка")" Class="ml-2" />
        </MudTooltip>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawer" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">@L.T("Дашборд")</MudNavLink>
            <MudNavLink Href="runs" Icon="@Icons.Material.Filled.PlayCircle">@L.T("Прогони")</MudNavLink>
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.overline" Class="px-4">@L.T("Налаштування")</MudText>
            <MudNavLink Href="profiles" Icon="@Icons.Material.Filled.Tune">@L.T("Профілі")</MudNavLink>
            <MudNavLink Href="templates" Icon="@Icons.Material.Filled.Rule">@L.T("Шаблони правил")</MudNavLink>
            <MudNavLink Href="connections" Icon="@Icons.Material.Filled.Key">@L.T("Підключення")</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink Href="help" Icon="@Icons.Material.Filled.MenuBook">@L.T("Довідка")</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="py-4">
            @* A new language rebuilds the page: texts computed when it was opened are computed again. *@
            <div @key="L.Language">@Body</div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawer = true;

    [Inject] private IServiceProvider Services { get; set; } = null!;

    private void SetLanguage(string code)
    {
        if (Services.GetService(typeof(LanguageStore)) is LanguageStore store)
            store.Save(code);
        else
            L.SetLanguage(code);
        StateHasChanged();
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#0f6cbd", AppbarBackground = "#0f6cbd" },
    };
}
