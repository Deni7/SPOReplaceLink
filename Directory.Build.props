<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Version of the app, the CLI and the installer (installer\build.ps1 reads it). -->
    <Version>1.2.0</Version>
  </PropertyGroup>

  <!--
    Release package (build\package.ps1): every project of the graph is built for the same runtime, so the Excel worker
    reached through Engine and through the app is one build and the folder carries its own .NET.
  -->
  <PropertyGroup Condition="'$(Packaging)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
</Project>
